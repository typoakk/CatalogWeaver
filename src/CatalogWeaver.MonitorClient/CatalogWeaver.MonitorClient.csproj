<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CatalogWeaver.MonitorClient</AssemblyName>
    <Version>0.2.0</Version>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="MonitorWeb/*" LogicalName="CatalogWeaver.Web.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
