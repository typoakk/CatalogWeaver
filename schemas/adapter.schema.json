    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^(?!secret:)[A-Za-z][A-Za-z0-9_:.-]*$"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "provider",
    "displayName",
    "kind",
    "baseUrl",
    "sourceUrlTemplate",
    "destinations",
    "requests",
    "mapping"
  ],
