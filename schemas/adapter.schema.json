{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogWeaver adapter",
  "description": "CatalogWeaver configVersion 1. JSON Schema validates structure; the service validates semantic references, installed profiles and database compatibility.",
  "type": "object",
  "properties": {
    "configVersion": {
      "const": 1
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "enabled": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "anime",
        "game",
        "film",
        "series",
        "book",
        "manga",
        "music"
      ]
    },
    "refreshHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8784
    },
    "baseUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "sourceUrlTemplate": {
      "type": "string",
      "minLength": 1
    },
    "allowedHosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "requestsPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "additionalProperties": false
    },
    "destinations": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1,
              "description": "Within Importer:MediaRoot; .staging is reserved."
            }
          },
          "additionalProperties": false,
          "required": [
            "directory"
          ]
        },
        "database": {
          "anyOf": [
            {
              "$ref": "database.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "files"
      ]
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "requests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/request"
      },
      "minProperties": 1,
      "maxProperties": 32
    },
    "mapping": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "properties": {
            "externalId": {
              "$ref": "#/$defs/field"
            },
            "title": {
              "$ref": "#/$defs/field"
            },
            "originalTitle": {
              "$ref": "#/$defs/field"
            },
            "alternativeTitles": {
              "$ref": "#/$defs/field"
            },
            "description": {
              "$ref": "#/$defs/field"
            },
            "genres": {
              "$ref": "#/$defs/field"
            },
            "tags": {
              "$ref": "#/$defs/field"
            },
            "creator": {
              "$ref": "#/$defs/field"
            },
            "year": {
              "$ref": "#/$defs/field"
            },
            "rating": {
              "$ref": "#/$defs/field"
            },
            "episodes": {
              "$ref": "#/$defs/field"
            },
            "releaseStatus": {
              "$ref": "#/$defs/field"
            },
            "country": {
              "$ref": "#/$defs/field"
            },
            "language": {
              "$ref": "#/$defs/field"
            }
          },
          "additionalProperties": false,
          "required": [
            "title"
          ]
        },
        "assets": {
          "type": "object",
          "properties": {
            "poster": {
              "$ref": "#/$defs/assetMapping"
            },
            "hero": {
              "$ref": "#/$defs/assetMapping"
            },
            "logo": {
              "$ref": "#/$defs/assetMapping"
            },
            "header": {
              "$ref": "#/$defs/assetMapping"
            },
            "background": {
              "$ref": "#/$defs/assetMapping"
            },
            "screenshot": {
              "$ref": "#/$defs/assetMapping"
            },
            "video": {
              "$ref": "#/$defs/assetMapping"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "fields"
      ]
    },
    "assetPolicies": {
      "type": "object",
      "properties": {
        "poster": {
          "$ref": "#/$defs/policy"
        },
        "hero": {
          "$ref": "#/$defs/policy"
        },
        "logo": {
          "$ref": "#/$defs/policy"
        },
        "header": {
          "$ref": "#/$defs/policy"
        },
        "background": {
          "$ref": "#/$defs/policy"
        },
        "screenshot": {
          "$ref": "#/$defs/policy"
        },
        "video": {
          "$ref": "#/$defs/policy"
        }
